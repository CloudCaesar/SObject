{
  "name": "SOObject",
  "displayName": "SObject",
  "description": "Salesforce development toolkit with Apex notebooks, SObject code generation, schema analysis, and permission auditing tools",
  "version": "0.6.0",
  "repository": {
    "url": "https://github.com/CloudCaesar/SObject"
  },
  "icon": "media/basil128x128.jpg",
  "engines": {
    "vscode": "^1.84.2"
  },
  "categories": [
    "Other",
    "Notebooks"
  ],
  "keywords": [
    "Kernal",
    "Apex",
    "SOQL",
    "Notebook",
    "Salesforce"
  ],
  "author": {
    "name": "Cloud CZR"
  },
  "publisher": "CloudCZR",
  "activationEvents": [
    "onCommand:anonymous-apex-notebook.create-apex-notebook",
    "onCommand:anonymous-apex-notebook.sobject2apex",
    "onCommand:anonymous-apex-notebook.sobject2apex-parentchild",
    "onCommand:anonymous-apex-notebook.sobject2apex-childparent",
    "onCommand:anonymous-apex-notebook.sobject-schema",
    "onCommand:anonymous-apex-notebook.sobject-permissions",
    "onCommand:anonymous-apex-notebook.sobject-user-permissions",
    "onCommand:anonymous-apex-notebook.sobject-field-security",
    "onNotebook:anon-apex-notebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anonymous-apex-notebook.create-apex-notebook",
        "title": "New Apex Notebook",
        "category": "Create"
      },
      {
        "command": "anonymous-apex-notebook.sobject2apex",
        "title": "SObject to Apex",
        "category": "Create"
      },
      {
        "command": "anonymous-apex-notebook.sobject2apex-parentchild",
        "title": "SObject to Apex ParentChild",
        "category": "Create"
      },
      {
        "command": "anonymous-apex-notebook.sobject2apex-childparent",
        "title": "SObject to Apex Child Parent",
        "category": "Create"
      },
      {
        "command": "anonymous-apex-notebook.sobject-schema",
        "title": "SObject Schema",
        "category": "Create"
      },
      {
        "command": "anonymous-apex-notebook.sobject-permissions",
        "title": "SObject Permissions",
        "category": "Create"
      },
      {
        "command": "anonymous-apex-notebook.sobject-user-permissions",
        "title": "SObject User Permissions",
        "category": "Create"
      },
      {
        "command": "anonymous-apex-notebook.sobject-field-security",
        "title": "SObject Field Level Security",
        "category": "Create"
      }
    ],
    "configuration": {
      "title": "Apex Notebooks",
      "properties": {
        "anonymous-apex-notebook.apexConfirmDialogPreference": {
          "type": "string",
          "description": "When running apex inside of the notebook, should it ask for confirmation before running the script?",
          "default": "Always",
          "order": 0,
          "enum": [
            "Always",
            "Only when running multiple",
            "Never"
          ]
        },
        "anonymous-apex-notebook.enableSoqlJsonOutput": {
          "type": "boolean",
          "description": "When executing a SOQL, should the JSON of the SOQL request be displayed in addition to the HTML table view?",
          "default": false,
          "order": 0
        },
        "anonymous-apex-notebook.showApexDebugOnlyCellOutput": {
          "type": "boolean",
          "description": "Should Anon Apex cells show an additional \"Debug Only\" output?",
          "default": true,
          "order": 0
        },
        "anonymous-apex-notebook.promptForTargetOrgWhenExecutingCells": {
          "type": "string",
          "description": "When executing cells, prompt for a target org?",
          "default": "Never prompt, always use default org",
          "order": 0,
          "enum": [
            "Always prompt",
            "Never prompt, always use default org"
          ]
        },
        "anonymous-apex-notebook.enableGpt52CodexForAllClients": {
          "type": "boolean",
          "description": "Enable GPT-5.2-Codex for all clients",
          "default": true,
          "order": 0
        }
      }
    },
    "notebooks": [
      {
        "type": "anon-apex-notebook",
        "displayName": "Anonymous Apex Notebook",
        "selector": [
          {
            "filenamePattern": "*.apexnotebook"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.4",
    "@types/mocha": "^9.0.0",
    "@types/node": "14.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.84.2",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.1.0",
    "@vscode/test-electron": "^1.6.2",
    "eslint": "^8.1.0",
    "glob": "^7.1.7",
    "mocha": "^9.1.3",
    "sinon": "^21.0.1",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "@salesforce/apex-node": "^3.0.2",
    "@salesforce/core": "^6.7.0",
    "rxjs": "^7.8.0",
    "semantic-ui-css": "^2.5.0",
    "tslib": "^2.3.0"
  }
}
